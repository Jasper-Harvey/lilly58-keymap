#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NUM  1
#define NAV  2
#define SYM  3
#define FUNC 4
#define MISC 5

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    combos {
        compatible = "zmk,combos";

        // Vertical bracket combos: E+D ( , I+K ) , R+F { , U+J } , T+G [ , Y+H ]
        combo_lpar {
            timeout-ms = <50>;
            key-positions = <15 27>;
            bindings = <&kp LPAR>;
        };
        combo_rpar {
            timeout-ms = <50>;
            key-positions = <20 32>;
            bindings = <&kp RPAR>;
        };
        combo_lbrc {
            timeout-ms = <50>;
            key-positions = <16 28>;
            bindings = <&kp LBRC>;
        };
        combo_rbrc {
            timeout-ms = <50>;
            key-positions = <19 31>;
            bindings = <&kp RBRC>;
        };
        combo_lbkt {
            timeout-ms = <50>;
            key-positions = <17 29>;
            bindings = <&kp LBKT>;
        };
        combo_rbkt {
            timeout-ms = <50>;
            key-positions = <18 30>;
            bindings = <&kp RBKT>;
        };
        // U+I caps word, M+, backspace
        combo_caps_word {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&caps_word>;
        };
        combo_bspc {
            timeout-ms = <50>;
            key-positions = <45 46>;
            bindings = <&kp BSPC>;
        };
        // D+C copy, F+V paste
        combo_copy {
            timeout-ms = <50>;
            key-positions = <27 39>;
            bindings = <&kp LC(C)>;
        };
        combo_paste {
            timeout-ms = <50>;
            key-positions = <28 40>;
            bindings = <&kp LC(V)>;
        };
        minus {
            bindings = <&kp MINUS>;
            key-positions = <32 33>;
        };
        underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <26 27>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Standard side modifiers (Esc/Ctrl/Shift, Bksp/'/Shift). Layer keys
        // sit on the inner thumbs: NUM+Enter, SYM+Tab, NAV+Space, FUNC.
        home_layer {
            label = "HOME";
            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                      &kp N6  &kp N7  &kp N8    &kp N9   &kp N0    &trans
&trans    &kp Q   &kp W   &kp E   &kp R   &kp T                       &kp Y   &kp U   &kp I     &kp O    &kp P     &kp BSPC
&kp LSHFT  &kp A   &kp S   &kp D   &kp F   &kp G                       &kp H   &kp J   &kp K     &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &mt LGUI Z  &mt LALT X  &mt LSFT C  &mt LCTL V  &kp B   &kp ESC   &trans     &kp N  &mt RCTL M  &mt RSFT COMMA  &mt RALT DOT  &mt RGUI FSLH  &kp RSHFT
                   &kp LGUI  &kp LALT  &lt NUM RET  &lt SYM TAB    &mo FUNC  &lt NAV SPACE  &lt MISC DEL  &kp RALT
            >;
        };

        // Numbers on top, shifted symbols on the home row below them.
        num_layer {
            label = "NUM";
            bindings = <
&trans  &trans    &trans    &trans    &trans    &trans                      &trans     &trans     &trans         &trans   &trans   &trans
&trans  &trans    &trans    &trans    &trans    &trans                      &trans     &trans     &trans         &trans   &trans   &trans
&trans  &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT                   &kp CARET  &kp AMPS   &kp ASTERISK   &none    &none    &trans
&trans  &none     &kp GRAVE &kp TILDE &kp PLUS  &kp UNDERSCORE  &trans &trans  &kp MINUS  &kp EQUAL  &none      &none    &kp PIPE &kp BSLH
                            &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        nav_layer {
            label = "NAV";
            bindings = <
&trans  &trans     &trans    &trans     &trans     &trans                  &trans     &trans     &trans    &trans     &trans  &trans
&trans  &none      &none     &none      &none      &none                   &kp HOME   &none      &kp DEL   &kp END    &none   &trans
&trans  &kp LGUI   &kp LALT  &kp LCTRL  &kp LSHFT  &none                   &kp LEFT   &kp DOWN   &kp UP    &kp RIGHT  &none   &trans
&trans  &none      &none     &none      &none      &none   &trans  &trans  &none      &none      &none     &none      &none   &trans
                             &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        sym_layer {
            label = "SYM";
            bindings = <
&trans  &kp F1     &kp F2    &kp F3     &kp F4     &kp F5                  &kp F6     &kp F7     &kp F8    &kp F9     &kp F10  &kp F11
&trans  &kp EXCL   &kp AT    &kp HASH   &kp DLLR   &kp PRCNT               &kp CARET  &kp AMPS        &kp ASTERISK   &kp LPAR  &kp RPAR  &kp F12
&trans  &none      &none     &none      &none      &none                   &none      &kp UNDERSCORE  &kp PLUS       &kp LBRC  &kp RBRC  &trans
&trans  &none      &none     &none      &none      &none   &trans  &trans  &none      &none           &none          &none     &none     &kp PIPE
                             &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        func_layer {
            label = "FUNC";
            bindings = <
&trans  &trans     &trans    &trans     &trans     &trans                  &trans     &trans     &trans    &trans     &trans  &trans
&trans  &kp F1     &kp F2    &kp F3     &kp F4     &kp F5                  &kp F6     &kp F7     &kp F8    &kp F9     &kp F10 &trans
&trans  &none      &none     &none      &kp F11    &kp F12                 &none      &none      &none     &none      &none   &trans
&trans  &kp CAPS   &none     &none      &none      &none   &trans  &trans  &none      &none      &none     &none      &none   &kp PRINTSCREEN
                             &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        // Reset / bootloader / Bluetooth controls.
        misc_layer {
            label = "MISC";
            bindings = <
&trans  &trans      &trans      &trans      &trans      &trans                  &trans        &trans  &trans  &trans  &trans  &trans
&trans  &sys_reset  &bootloader &bt BT_CLR  &bt BT_PRV  &bt BT_NXT              &out OUT_TOG  &none   &none   &none   &none   &trans
&trans  &none       &none       &none       &none       &none                   &none         &none   &none   &none   &none   &trans
&trans  &none       &none       &none       &none       &none   &trans  &trans  &none         &none   &none   &none   &none   &trans
                                &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
