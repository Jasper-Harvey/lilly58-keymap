#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NUM  1
#define NAV  2
#define SYM  3
#define FUNC 4
#define MISC 5

&lt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

/ {
    combos {
        compatible = "zmk,combos";

        brace_right {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <45 46>;
        };
        brace_left {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <39 40>;
        };
        paren_right {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <31 32>;
        };
        paren_left {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <27 28>;
        };
        bracket_left {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <19 20>;
        };
        bracket_right {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <15 16>;
        };
        minus {
            bindings = <&kp MINUS>;
            key-positions = <32 33>;
        };
        underscore {
            bindings = <&kp UNDERSCORE>;
            key-positions = <26 27>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Standard side modifiers (Esc/Ctrl/Shift, Bksp/'/Shift). Layer keys
        // sit on the inner thumbs: NUM+Enter, SYM+Tab, NAV+Space, FUNC.
        home_layer {
            label = "HOME";
            bindings = <
&kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                      &kp N6  &kp N7  &kp N8    &kp N9   &kp N0    &trans
&kp ESC    &kp Q   &kp W   &kp E   &kp R   &kp T                       &kp Y   &kp U   &kp I     &kp O    &kp P     &kp BSPC
&kp LCTRL  &kp A   &kp S   &kp D   &kp F   &kp G                       &kp H   &kp J   &kp K     &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C   &kp V   &kp B   &trans   &trans     &kp N   &kp M   &kp COMMA &kp DOT  &kp FSLH  &kp RSHFT
                   &kp LGUI  &kp LALT  &lt NUM RET  &lt SYM TAB    &mo FUNC  &lt NAV SPACE  &lt MISC DEL  &kp RALT
            >;
        };

        // Numbers on top, shifted symbols on the home row below them.
        num_layer {
            label = "NUM";
            bindings = <
&trans  &trans    &trans    &trans    &trans    &trans                      &trans     &trans     &trans         &trans   &trans   &trans
&trans  &trans    &trans    &trans    &trans    &trans                      &trans     &trans     &trans         &trans   &trans   &trans
&trans  &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT                   &kp CARET  &kp AMPS   &kp ASTERISK   &none    &none    &trans
&trans  &none     &kp GRAVE &kp TILDE &kp PLUS  &kp UNDERSCORE  &trans &trans  &kp MINUS  &kp EQUAL  &none      &none    &kp PIPE &kp BSLH
                            &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        nav_layer {
            label = "NAV";
            bindings = <
&trans  &trans     &trans    &trans     &trans     &trans                  &trans     &trans     &trans    &trans     &trans  &trans
&trans  &none      &none     &none      &none      &none                   &kp HOME   &none      &kp DEL   &kp END    &none   &trans
&trans  &kp LGUI   &kp LALT  &kp LCTRL  &kp LSHFT  &none                   &kp LEFT   &kp DOWN   &kp UP    &kp RIGHT  &none   &trans
&trans  &none      &none     &none      &none      &none   &trans  &trans  &none      &none      &none     &none      &none   &trans
                             &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        sym_layer {
            label = "SYM";
            bindings = <
&trans  &trans     &trans    &trans     &trans     &trans                  &trans     &trans          &trans         &trans    &trans    &trans
&trans  &kp EXCL   &kp AT    &kp HASH   &kp DLLR   &kp PRCNT               &kp CARET  &kp AMPS        &kp ASTERISK   &kp LPAR  &kp RPAR  &trans
&trans  &none      &none     &none      &none      &none                   &none      &kp UNDERSCORE  &kp PLUS       &kp LBRC  &kp RBRC  &trans
&trans  &none      &none     &none      &none      &none   &trans  &trans  &none      &none           &none          &none     &none     &kp PIPE
                             &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        func_layer {
            label = "FUNC";
            bindings = <
&trans  &trans     &trans    &trans     &trans     &trans                  &trans     &trans     &trans    &trans     &trans  &trans
&trans  &kp F1     &kp F2    &kp F3     &kp F4     &kp F5                  &kp F6     &kp F7     &kp F8    &kp F9     &kp F10 &trans
&trans  &none      &none     &none      &kp F11    &kp F12                 &none      &none      &none     &none      &none   &trans
&trans  &kp CAPS   &none     &none      &none      &none   &trans  &trans  &none      &none      &none     &none      &none   &kp PRINTSCREEN
                             &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        // Reset / bootloader / Bluetooth controls.
        misc_layer {
            label = "MISC";
            bindings = <
&trans  &trans      &trans      &trans      &trans      &trans                  &trans        &trans  &trans  &trans  &trans  &trans
&trans  &sys_reset  &bootloader &bt BT_CLR  &bt BT_PRV  &bt BT_NXT              &out OUT_TOG  &none   &none   &none   &none   &trans
&trans  &none       &none       &none       &none       &none                   &none         &none   &none   &none   &none   &trans
&trans  &none       &none       &none       &none       &none   &trans  &trans  &none         &none   &none   &none   &none   &trans
                                &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
